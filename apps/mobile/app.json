{
  "expo": {
    "name": "لَبّيك",
    "slug": "labbayk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/labbayk-app-icon.png",
    "scheme": "labbayk",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.hasan99.labbayk",
      "icon": "./assets/images/labbayk-app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hasan99.labbayk",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/labbayk-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/labbayk-app-icon.png"
    },
    "extra": {
      "webPushVapidPublicKey": "BHEAGWfH429jaR2hThAtU2UTRQ24C81fyG2PYE3CO5Myg4B73myc2hvcPdLWs638kLemoKueRkslVHWl06NM13U",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2b2c9056-cc66-4a6d-b34c-f91eee97cc3c"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#B7FF30",
          "defaultChannel": "order_updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "لإضافة صور تختارها لطلبك أو لملفك الشخصي.",
          "cameraPermission": "لتصوير إثبات تسليم الطلب للعميل.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/labbayk-delivery-logo.png",
          "imageWidth": 190
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-optional-android-features"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "hasan-jahouse",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2b2c9056-cc66-4a6d-b34c-f91eee97cc3c"
    }
  }
}
