# Supabase client configuration is added after the LABBAYK project is confirmed.
# Never place a service role or secret key in a client environment file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after enabling Phone Auth and configuring a real SMS provider in Supabase.
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set true only after enabling Phone Auth and configuring a real SMS provider in Supabase.
VITE_PHONE_AUTH_ENABLED=false
# Customer web app base URL used to create driver invitation links (optional in native dev).
VITE_CUSTOMER_APP_URL=
